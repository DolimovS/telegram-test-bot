{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "telegram-test-bot",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-14",
  "workers_dev": true,
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "telegram-test-bot",
    "database_id": "a0b00b3e-ab40-4326-8ed1-43c266d4c7d6",
    "migrations_dir": "migrations"
  }]
}
